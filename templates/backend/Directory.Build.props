<Project>
  <!--
    Shared by every project under api/. Added by inv-forge.
    Zero warnings is the rule: a warning fails the build, here and in CI. Fix the cause;
    do not add NoWarn or pragmas (inv-forge blocks those edits).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Thresholds for the code-metrics rules enabled in .editorconfig. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>
</Project>
